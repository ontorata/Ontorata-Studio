# Ontorata Studio environment profiles (Phase 19)
# Copy to .env.local and adjust per profile.

# --- Profile selector (local | staging | production) ---
VITE_STUDIO_PROFILE=local

# --- Ratary connection defaults ---
# Local dev:
VITE_RATARY_BASE_URL=http://localhost:9876
# Staging / production (set in Vercel Project → Environment Variables):
# VITE_RATARY_BASE_URL=https://ratary.ontorata.com

# Do NOT set VITE_RATARY_API_KEY in production — users sign in via login or connection wizard.
# Optional for local dev only:
# VITE_RATARY_API_KEY=

# Optional workspace scope (UUID from Ratary workspaces table).
# MCP coding-memory default (owner 3d7a5c31…):
# VITE_RATARY_WORKSPACE_ID=f599be05-0e83-4105-849a-1d68262ea0cc
# Pilot CDSB (different owner — empty for MCP memories):
# VITE_RATARY_WORKSPACE_ID=356ede13-0948-44aa-81a6-e75023523c6d

# --- OIDC (Phase 04) — omit for legacy API-key mode ---
# Zitadel (production — issuer = instance URL, NOT /realms/...):
# VITE_AUTH_ISSUER=https://<your-instance>.zitadel.cloud
# VITE_AUTH_CLIENT_ID=<client-id-from-zitadel-user-agent-app>
# Post-logout redirect must be allowlisted in Zitadel (e.g. https://studio.ontorata.com/login).
# Keycloak (self-host alternative):
# VITE_AUTH_ISSUER=http://localhost:8080/realms/ontorata
# VITE_AUTH_ISSUER=https://auth.ontorata.com/realms/ontorata
# VITE_AUTH_CLIENT_ID=studio-spa

# --- Ontory Runtime (REST) — Owner VPS preferred (ARCH-0217) ---
# Production / staging profile defaults to https://vps.ontorata.com when unset.
# VITE_ONTORY_BASE_URL=https://vps.ontorata.com
# Local Vite proxies /ontory → this target (default = VPS):
# VITE_ONTORY_PROXY_TARGET=https://vps.ontorata.com
# Local Runtime rehearsal instead:
# VITE_ONTORY_PROXY_TARGET=http://localhost:9787
# VITE_ONTORY_BASE_URL=http://localhost:9787

# --- Ontory product link-out ---
# VITE_ONTORY_URL=https://ontorata.com/ontory
